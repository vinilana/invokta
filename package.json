{
  "name": "invokta",
  "version": "0.2.0",
  "private": true,
  "description": "A TypeScript framework for building reusable Action Engines.",
  "author": "Vini Lana <vini@aicoders.academy>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vinilana/invokta.git"
  },
  "homepage": "https://docs.invokta.dev/",
  "bugs": {
    "url": "https://github.com/vinilana/invokta/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22.20.0"
  },
  "packageManager": "yarn@1.22.22",
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "build": "tsc -b --pretty false",
    "typecheck": "tsc -b --pretty false && tsc -p tsconfig.test.json --pretty false --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "lint": "biome lint .",
    "format:check": "biome format .",
    "release:verify": "node scripts/verify-release-packages.mjs",
    "check": "yarn typecheck && yarn lint && yarn format:check && yarn test:run && yarn build"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@types/node": "26.1.2",
    "typescript": "7.0.2",
    "vitest": "4.1.10",
    "zod": "4.4.3"
  }
}
