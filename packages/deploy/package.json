{
  "name": "@invokta/deploy",
  "version": "0.2.0",
  "description": "HTTP engine scaffolding, packaging, and probing tools for Invokta.",
  "author": "Vini Lana <vini@aicoders.academy>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vinilana/invokta.git",
    "directory": "packages/deploy"
  },
  "homepage": "https://docs.invokta.dev/reference/deploy/",
  "bugs": {
    "url": "https://github.com/vinilana/invokta/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22.20.0"
  },
  "files": [
    "dist"
  ],
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "invokta-deploy": "./dist/bin.js"
  },
  "scripts": {
    "build": "tsc -b --pretty false",
    "prepack": "npm run --silent build"
  }
}
