{
  "name": "@invokta/otel",
  "version": "0.10.0",
  "description": "OpenTelemetry trace and metric instrumentation built from Invokta engine events.",
  "author": "Vini Lana <vini@aicoders.academy>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vinilana/invokta.git",
    "directory": "packages/otel"
  },
  "homepage": "https://docs.invokta.dev/reference/otel/",
  "bugs": {
    "url": "https://github.com/vinilana/invokta/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22.20.0"
  },
  "files": [
    "dist"
  ],
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b --pretty false",
    "prepack": "npm run --silent build"
  },
  "dependencies": {
    "@invokta/core": "0.10.0"
  },
  "peerDependencies": {
    "@opentelemetry/api": "^1.9.0"
  },
  "devDependencies": {
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/context-async-hooks": "2.12.0",
    "@opentelemetry/sdk-metrics": "2.12.0",
    "@opentelemetry/sdk-trace": "2.12.0"
  }
}
