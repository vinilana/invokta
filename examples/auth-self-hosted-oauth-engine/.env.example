DATABASE_URL=postgresql://invokta_app:replace-with-a-strong-database-password@127.0.0.1:5432/invokta_app
POSTGRES_DB=invokta_app
POSTGRES_USER=invokta_app
POSTGRES_PASSWORD=replace-with-a-strong-database-password
POSTGRES_BIND_ADDRESS=127.0.0.1
POSTGRES_PORT=5432

APP_PUBLIC_URL=https://mcp.example.com
APP_PUBLIC_HOST=mcp.example.com
APP_TRAEFIK_ROUTER_PREFIX=invokta-app
APP_TRAEFIK_CERTRESOLVER=letsencrypt
INVOKTA_HTTP_AUTH_MODE=oauth
# INVOKTA_HTTP_ALLOWED_HOSTS=mcp.example.com,localhost,127.0.0.1,engine
# INVOKTA_HTTP_ALLOWED_ORIGINS=https://mcp.example.com
# INVOKTA_HTTP_MAX_BODY_BYTES=1048576
# Static Bearer authentication is an explicit compatibility fallback only:
# INVOKTA_HTTP_AUTH_MODE=bearer
# INVOKTA_HTTP_BEARER_TOKEN=replace-with-at-least-32-random-characters
# INVOKTA_HTTP_PRINCIPAL_ID=person:owner
APP_BIND_ADDRESS=127.0.0.1
APP_HTTP_PORT=3000
APP_OAUTH_PORT=3001
APP_PROXY_BIND_ADDRESS=0.0.0.0

APP_PRINCIPAL_ID=local:user
