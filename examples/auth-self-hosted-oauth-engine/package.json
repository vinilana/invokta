{
  "name": "@invokta/example-auth-self-hosted-oauth",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.20.0"
  },
  "bin": {
    "auth-self-hosted-oauth-engine": "./dist/bin.js"
  },
  "files": [
    "dist",
    "migrations",
    "invokta.mcp.json"
  ],
  "scripts": {
    "build": "tsc -b --pretty false",
    "typecheck": "tsc -b --pretty false && tsc -p tsconfig.test.json --pretty false --noEmit",
    "test": "vitest run test",
    "check": "tsc -b --pretty false && tsc -p tsconfig.test.json --pretty false --noEmit && vitest run test && invokta check-mcp ./dist/engine.js",
    "check:mcp": "invokta check-mcp ./dist/engine.js",
    "db:migrate": "tsc -b --pretty false && node dist/database/migrate.js",
    "direct": "node dist/direct.js",
    "devtools": "tsc -b --pretty false && invokta-devtools serve dist/engine.js --watch --build \"tsc -b --pretty false\"",
    "devtools:doctor": "tsc -b --pretty false && invokta-devtools doctor dist/engine.js",
    "cli": "node dist/cli.js",
    "mcp:stdio": "node dist/mcp-stdio.js",
    "mcp:install": "tsc -b --pretty false && invokta-installer install --engine .",
    "mcp:uninstall": "invokta-installer remove --engine .",
    "mcp:http": "node dist/mcp-http.js",
    "oauth:serve": "node dist/oauth-server.js",
    "oauth:bootstrap": "node dist/oauth/bootstrap-owner.js",
    "oauth:probe-dcr": "node scripts/probe-dcr.mjs",
    "deploy:package": "invokta-deploy package",
    "deploy:probe": "invokta-deploy probe",
    "deploy:inspect-oauth": "invokta-deploy inspect-oauth"
  },
  "dependencies": {
    "@invokta/cli": "0.9.0",
    "@invokta/core": "0.9.0",
    "@invokta/installer": "0.9.0",
    "@invokta/mcp": "0.9.0",
    "jose": "^6.2.8",
    "oidc-provider": "~9.11.3",
    "pg": "^8.16.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@invokta/deploy": "0.9.0",
    "@invokta/devtools": "0.9.0",
    "@invokta/tooling": "0.9.0",
    "@types/node": "26.1.2",
    "@types/oidc-provider": "^9.11.1",
    "@types/pg": "^8.23.1",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
